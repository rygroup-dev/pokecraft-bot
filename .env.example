# Salin file ini jadi .env lalu isi. JANGAN bagikan .env ke siapa pun.

# Private key wallet Solana (format base58 dari Phantom: Settings > Export Private Key)
PRIVATE_KEY=

# Token bot dari @BotFather dan ID Telegram kamu (cek di @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Kode referral (default: pembuat bot). Dipasang sekali untuk akun yang belum punya referral.
REF_CODE=tcswarv7

# Opsional: RPC Solana sendiri kalau RPC publik diblokir jaringanmu
SOLANA_RPC=
